"""Type stubs for the compiled extension joint_controller._joint_controller."""

from typing import Any, Mapping

import numpy as np
import numpy.typing as npt

_Array = npt.ArrayLike
_F64 = npt.NDArray[np.float64]
# Parameter dicts: vectors (7,) for stiffness, damping, max_velocity, max_acceleration,
# lower_limit, upper_limit; floats for velocity_filter_alpha, min_segment_duration_s,
# limit_margin, command_timeout_s, max_delta_tau; a bool for compensate_coriolis.
_Params = dict[str, Any]

__version__: str
GELLO_COMMIT: str
WITH_FRANKY: bool
# compiled-in copy of joint_controller/build_info.json
BUILD_INFO: dict[str, Any]
# the 12 parameter names, in declaration order
PARAM_FIELDS: tuple[str, ...]

def default_params(robot_model: str) -> _Params: ...
def validate_params(params: Mapping[str, Any]) -> _Params: ...

class TrajectoryImpedanceLaw:
    def __init__(self, params: Mapping[str, Any]) -> None: ...
    def apply_params(self, updates: Mapping[str, Any]) -> _Params: ...
    def params(self) -> _Params: ...
    def starting(self, q: _Array, tau_prev: _Array = ...) -> None: ...
    def set_target(self, q: _Array) -> bool: ...
    def request_stop(self) -> None: ...
    def step(self, q: _Array, dq: _Array, coriolis: _Array, dt: float = 0.001) -> _F64: ...
    def telemetry(self) -> dict[str, Any]: ...

# Only present when built with franky (WITH_FRANKY is True); subclasses franky.BaseTorqueMotion.
class TrajectoryImpedanceMotion:
    def __init__(self, params: Mapping[str, Any]) -> None: ...
    def set_target(self, q: _Array) -> bool: ...
    def update_params(self, updates: Mapping[str, Any]) -> _Params: ...
    def params(self) -> _Params: ...
    # ticks, rel_time, q, dq, dq_filtered, coriolis, q_ref, dq_ref, ddq_ref, target, goal, tau_cmd,
    # segment_t, segment_T, time_since_target, timed_out, stopped, target_pending, plan_retries,
    # applied_command_seq, applied_params_seq
    def telemetry(self) -> dict[str, Any]: ...
    def request_stop(self) -> None: ...
    def _offline_step(self, q: _Array, dq: _Array, coriolis: _Array, dt: float = 0.001) -> _F64: ...
